# AI layer: any OpenAI-compatible endpoint. Leave EHDS_LLM_BASE_URL empty for rules-only mode.
# Only request text (organisation, purpose, question) is sent; never patient data.

# a) Self-hosted vLLM on the A1 Digital GPU in Vienna (see vllm.sh)
EHDS_LLM_BASE_URL=http://<a1-gpu-host>:8001/v1
EHDS_LLM_MODEL=mistral-small-3.2-24b-instruct
EHDS_LLM_API_KEY=not-needed

# b) EU inference provider (e.g. TensorX, Mistral La Plateforme, Scaleway, IONOS)
# EHDS_LLM_BASE_URL=https://<provider>/v1
# EHDS_LLM_MODEL=<model id>
# EHDS_LLM_API_KEY=<key>

# c) Local stand-in for testing the AI path without a GPU (NOT a model)
# EHDS_LLM_BASE_URL=http://127.0.0.1:8099/v1
# EHDS_LLM_MODEL=fake

EHDS_LLM_TIMEOUT=25
