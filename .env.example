# Copy to .env (gitignored). Every value is optional.

# Directory that contains data/*.csv and requests/ (default: auto-detect an ancestor with track3/requests/expected.json)
# TRACK3_DATA=C:/path/to/track3

# Runtime data (SPE copies, audit logs, caches). Default: <repo>/var
# EHDS_VAR_DIR=var

# LLM assistance: "auto" (use it when a key is set) or "off" (rules only)
# EHDS_LLM=auto
# ANTHROPIC_API_KEY=
# EHDS_LLM_MODEL=claude-opus-5-5
